# MongoDB Connection String (Local MongoDB with Replica Set for Transactions)
MONGODB_URI="mongodb://127.0.0.1:27017/next_ecommerce_cms?retryWrites=false"

# Auth.js Secret (می‌توانید هر متن دلخواهی بگذارید یا با npx auth secret تولید کنید)
AUTH_SECRET="my-super-secret-key-123456789"
AUTH_URL="http://localhost:3000"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# اکانت‌های پیش‌فرض برای ورود سریع
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="Admin@1234"
DEMO_ADMIN_EMAIL="demo@example.com"
DEMO_ADMIN_PASSWORD="Demo@1234"