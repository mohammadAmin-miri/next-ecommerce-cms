# MongoDB Connection String (Local or MongoDB Atlas Replica Set)
MONGODB_URI="mongodb://127.0.0.1:27017/next_ecommerce_cms?replicaSet=rs0"

# Auth.js (NextAuth v5) Secret - Generate via: npx auth secret
AUTH_SECRET="your-super-secret-jwt-key-change-in-production"
AUTH_URL="http://localhost:3000"

# Public App URL (Used for SEO, Sitemap, and Canonical URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"